{
  "name": "cinemax-mcp-server",
  "version": "1.0.0",
  "type": "module",
  "description": "MCP server for the Cinemax cinema booking platform — Phase 1 read-only",
  "bin": {
    "cinemax-mcp": "src/server.js"
  },
  "scripts": {
    "start": "node src/server.js",
    "start:http": "cross-env MCP_TRANSPORT=http node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.8.0",
    "axios": "^1.7.9",
    "cross-env": "^7.0.3",
    "dotenv": "^16.5.0",
    "pg": "^8.16.2",
    "pino": "^9.6.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "vitest": "^4.1.8"
  }
}
