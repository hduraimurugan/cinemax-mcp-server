# ============================================================================
# Cinemax MCP Server — Environment Configuration
# ============================================================================

# --- Required: PostgreSQL Read-Only Connection ---
# Use the cinemax_reader role created by sql/01_readonly_role.sql
DATABASE_URL=postgresql://cinemax_reader:your_secure_password@localhost:5432/cinema_hall_db
# Neon (production):
# DATABASE_URL=postgresql://cinemax_reader:password@ep-xxx.us-east-2.aws.neon.tech/cinema_hall_db?sslmode=require

# --- Cinemax API Base URL ---
# Used for REST API proxy tools (movie catalog, dashboard, etc.)
API_BASE_URL=http://localhost:5000
# Production:
# API_BASE_URL=https://cinema-hall-api.vercel.app

# --- Transport ---
# "stdio" for local AI assistants (Claude Desktop, Cursor, Cline, etc.)
# "http" for remote access (ChatGPT, OpenAI Agents, web)
MCP_TRANSPORT=stdio

# HTTP mode port (only used when MCP_TRANSPORT=http)
HTTP_PORT=8787

# --- API Key Configuration ---
# Every admin (owner, admin, or any staff role) can generate their own
# personal key from Settings > API Keys in the admin panel (or POST
# /api/api-keys while logged in). The MCP server resolves it against
# GET /api/api-keys/context, so each caller is bound by their own real
# Roles & Permissions and hall assignments — never a shared identity.

# stdio mode (Claude Desktop, Cursor, Cline, etc.) — exactly one caller for
# the life of the process, so it's set here.
CINEMAX_MCP_API_KEY=cmk_your_personal_key_here

# HTTP mode does NOT use this variable — each request supplies its own key
# via the x-api-key header instead, so multiple people can share one
# deployed server while each acting under their own permissions.

# --- Logging ---
# Levels: fatal, error, warn, info, debug, trace
LOG_LEVEL=info

# --- Optional: Sentry Error Tracking ---
# SENTRY_DSN=https://key@oorg.ingest.us.sentry.io/project

# --- Optional: Redis for multi-instance rate limiting (HTTP mode only) ---
# REDIS_URL=redis://localhost:6379
